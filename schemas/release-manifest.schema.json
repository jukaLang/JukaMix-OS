{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jukalang.com/schemas/jukamix-release-manifest.schema.json",
  "title": "JukaMix-OS Release Manifest",
  "type": "object",
  "required": [
    "schema",
    "version",
    "generated_at",
    "files"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
