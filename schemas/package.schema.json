{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jukalang.com/schemas/jukamix-package.schema.json",
  "title": "JukaMix Package",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "devices",
    "operations"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "minimum_jukamix": {
      "type": "string"
    },
    "depends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "dest"
        ],
        "properties": {
          "kind": {
            "enum": [
              "install",
              "replace",
              "remove",
              "executable",
              "chmod"
            ]
          },
          "src": {
            "type": "string"
          },
          "dest": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mode": {
            "type": "string",
            "pattern": "^[0-7]{3,4}$"
          },
          "keep_user": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
